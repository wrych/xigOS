{
  "name": "xigos",
  "version": "0.2.0",
  "private": true,
  "description": "xigo's harness, packaged as a Claude Code plugin",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test \"tests/**/*.test.mjs\"",
    "validate": "claude plugin validate . && claude plugin validate --strict .claude-plugin/marketplace.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "review": "node scripts/review/run.mjs",
    "eval": "node --test \"evals/**/*.eval.mjs\"",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "3.6.2"
  },
  "bin": {
    "xigos-review": "scripts/review/run.mjs"
  },
  "lint-staged": {
    "*.{js,mjs,json,md,yml,yaml}": [
      "prettier --write"
    ]
  }
}
